#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Only lint the files actually being committed, not the whole codebase
echo "📝 Checking staged files with ESLint..."
npx lint-staged

if [ $? -ne 0 ]; then
  echo "❌ ESLint found issues. Please fix them before committing."
  exit 1
fi

echo "✅ All checks passed! Proceeding with commit..."