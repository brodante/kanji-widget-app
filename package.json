{
    "name": "kanji-widgets",
    "version": "1.0.0",
    "main": "audio-manager.js",
    "scripts": {
        "start": "node server.js",
        "lint": "eslint . --ext .js --ignore-pattern node_modules/ --ignore-pattern database/",
        "lint:fix": "eslint . --ext .js --ignore-pattern node_modules/ --ignore-pattern database/ --fix",
        "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
        "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
        "test": "node test/test-srs-ai.js && node --test test/test-backup.js test/test-account-ui.js test/test-profile-page.js test/test-app-auth.js test/test-cloud-sync.js test/test-main-integration.js && npm run test:drawing-pad",
        "prepare": "husky install",
        "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project demo-kanji-widget \"node --test test/test-firestore-rules.js\"",
        "test:drawing-pad": "node test/test-drawing-pad.js"
    },
    "lint-staged": {
        "*.{js,html,css,json,md}": "prettier --write",
        "*.js": "eslint --fix"
    },
    "keywords": [
        "kanji",
        "japanese",
        "learning",
        "pwa"
    ],
    "author": "d4nte",
    "license": "GPL-3.0",
    "description": "Interactive Japanese Kanji learning with widgets and spaced repetition",
    "dependencies": {
        "express": "^5.1.0"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.2",
        "eslint": "^8.53.0",
        "eslint-config-prettier": "^10.1.8",
        "fake-indexeddb": "^6.2.5",
        "firebase": "^12.3.0",
        "husky": "^8.0.3",
        "jsdom": "^30.1.0",
        "lint-staged": "^15.5.2",
        "prettier": "^3.1.0"
    }
}
