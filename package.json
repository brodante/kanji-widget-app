{
    "name": "kanji-widgets",
    "version": "1.0.0",
    "main": "audio-manager.js",
    "scripts": {
        "start": "node server.js",
        "lint": "eslint . --ext .js --ignore-pattern node_modules/ --ignore-pattern database/",
        "lint:fix": "eslint . --ext .js --ignore-pattern node_modules/ --ignore-pattern database/ --fix",
        "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore",
        "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore",
        "test": "node test/test-srs-ai.js && node --test test/test-backup.js test/test-account-ui.js test/test-profile-page.js",
        "prepare": "husky install"
    },
    "lint-staged": {
        "*.{js,html,css,json,md}": "prettier --write",
        "*.js": "eslint --fix"
    },
    "keywords": [
        "kanji",
        "japanese",
        "learning",
        "pwa"
    ],
    "author": "d4nte",
    "license": "GPL-3.0",
    "description": "Interactive Japanese Kanji learning with widgets and spaced repetition",
    "dependencies": {
        "express": "^5.1.0"
    },
    "devDependencies": {
        "eslint": "^8.53.0",
        "eslint-config-prettier": "^10.1.8",
        "fake-indexeddb": "^6.2.5",
        "husky": "^8.0.3",
        "jsdom": "^26.1.0",
        "lint-staged": "^15.5.2",
        "prettier": "^3.1.0"
    }
}
