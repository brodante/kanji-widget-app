{
    "name": "kanji-widgets",
    "version": "1.0.0",
    "main": "audio-manager.js",
    "scripts": {
        "start": "node server.js",
        "lint": "eslint . --ext .js --ignore-pattern node_modules/ --ignore-pattern database/",
        "lint:fix": "eslint . --ext .js --ignore-pattern node_modules/ --ignore-pattern database/ --fix",
        "format": "prettier --write . --ignore-path .gitignore",
        "format:check": "prettier --check . --ignore-path .gitignore",
        "test": "echo \"Error: no test specified\" && exit 1",
        "prepare": "husky install"
    },
    "keywords": [
        "kanji",
        "japanese",
        "learning",
        "pwa"
    ],
    "author": "d4nte",
    "license": "GPL-3.0",
    "description": "Interactive Japanese Kanji learning with widgets and spaced repetition",
    "dependencies": {
        "express": "^5.1.0"
    },
    "devDependencies": {
        "eslint": "^8.53.0",
        "prettier": "^3.1.0",
        "husky": "^8.0.0"
    }
}
